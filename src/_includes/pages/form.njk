{#- expects: formName, formKind ("contact" | "group") -#}
<form class="enquiry" name="{{ formName }}" method="POST" action="{{ langPrefix }}/thanks/" data-netlify="true" netlify-honeypot="website">
  <input type="hidden" name="form-name" value="{{ formName }}">
  <input type="hidden" name="language" value="{{ lang }}">
  <p class="hp"><label>{{ T.ui.form.honeypot }} <input name="website"></label></p>
  <div class="cols">
    <label>{{ T.ui.form.name }} <input name="name" required autocomplete="name"></label>
    <label>{{ T.ui.form.email }} <input name="email" type="email" required autocomplete="email"></label>
  </div>
  <div class="cols">
    <label>{{ T.ui.form.phone }} <input name="phone" type="tel" autocomplete="tel"></label>
    {%- if formKind == "group" %}
    <label>{{ T.ui.form.groupDates }} <input name="dates" placeholder="{{ T.ui.form.groupDatesPh }}"></label>
    {%- else %}
    <label>{{ T.ui.form.dates }} <input name="dates" placeholder="{{ T.ui.form.datesPh }}"></label>
    {%- endif %}
  </div>
  <label>{{ T.ui.form.message }} <textarea name="message" rows="5" required placeholder="{% if formKind == 'group' %}{{ T.ui.form.groupPh }}{% else %}{{ T.ui.form.messagePh }}{% endif %}"></textarea></label>
  <button type="submit" class="btn btn-dark">{{ T.ui.form.send }}</button>
  <p class="small">{{ T.ui.form.reply }}</p>
</form>
