{%- set house = T.house %}
<section><div class="wrap">
  <div class="narrow"><div class="rule"></div>
    <h1 style="font-size:clamp(1.8rem,3.4vw,2.3rem)">{{ house.title }}</h1>
    <div class="prose">{{ house.intro | md | safe }}</div>
  </div>
  <div class="gallery" style="margin-top:3rem">
  {%- for p in house.photos %}
    <figure>
      <img src="{{ p.image }}" alt="{{ p.caption }}" sizes="(min-width: 780px) 33vw, 50vw">
      <figcaption>{{ p.caption }}</figcaption>
    </figure>
  {%- endfor %}
  </div>
</div></section>

<section class="book"><div class="wrap">
  <h2>{{ T.ui.stayWithUs }}</h2>
  <p>{{ T.home.bookText }}</p>
  <a class="btn" href="{{ langPrefix }}/check-dates/">{{ T.ui.seeDates }}</a>
  <p style="margin-top:1.5rem;font-size:.95rem"><a href="tel:{{ site.phoneLink }}" style="color:#fff">{{ site.phone }}</a></p>
</div></section>
