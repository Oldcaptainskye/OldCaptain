<section><div class="wrap wrap-check">
<div class="narrow"><div class="rule"></div>
<h1 style="font-size:clamp(1.8rem,3.4vw,2.3rem)">{{ T.ui.checkDates }}</h1>
<p>{{ T.ui.directLine }}</p>
</div>
<div class="booking-frame" id="book">
<iframe src="{{ site.bookingUrl }}&lang={{ lang or 'en' }}" title="{{ T.ui.checkDates }} — availability and booking" loading="lazy"></iframe>
</div>
<div class="narrow" style="margin-top:2rem"><h2 style="font-size:1.4rem">{{ T.ui.bookInfo.h }}</h2>
<ul>
{% for it in T.ui.bookInfo.items %}<li>{{ it | replace("{from}", site.checkin) | replace("{until}", site.checkinUntil) | replace("{out}", site.checkout) }}</li>
{% endfor %}</ul>
<p><a href="{{ langPrefix }}/#rooms">{{ T.ui.rooms }}</a></p>
</div>
</div></section>
