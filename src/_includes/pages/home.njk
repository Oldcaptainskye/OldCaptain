{%- set home = T.home %}
<div class="statement"><div class="wrap">
  <h1>{{ home.headline }}</h1>
  <p>{{ home.intro }}</p>
  <p class="top-book"><a href="{{ site.bookingUrl }}">{{ T.ui.seeDates }}</a>
    <span>{{ T.ui.orCall }} <a href="tel:{{ site.phoneLink }}">{{ site.phone }}</a></span></p>
</div></div>

<figure class="plate">
  <img src="{{ site.heroImage }}" alt="{{ home.heroAlt }}" sizes="100vw" loading="eager" fetchpriority="high">
  <figcaption class="caption">{{ home.heroCaption }}</figcaption>
</figure>

<section id="rooms"><div class="wrap wrap-rooms">
  <div class="narrow"><div class="rule"></div>
    <h2>{{ T.ui.rooms }}</h2>
    <p>{{ home.roomsIntro }}</p>
  </div>

  <div style="margin-top:4rem">
  {%- for room in collections["rooms_" + lang] %}
    <article class="room">
      <div class="shot">
        <a href="{{ room.url }}"><img src="{{ room.data.image }}" alt="{{ room.data.imageAlt }}" sizes="(min-width: 860px) 40vw, 100vw"></a>
      </div>
      <div class="text">
        <div class="rlabel">
          <h3><a href="{{ room.url }}">{{ room.data.title }}</a></h3>
          <span class="n">{{ room.data.type | upper }} &middot; {{ T.ui.sleeps | upper }} {{ room.data.sleeps }}</span>
        </div>
        <p>{{ room.data.summary }}</p>
        <div class="rate">{% if room.data.rate %}{{ T.ui.fromNight | replace("{rate}", room.data.rate) }}{% endif %}
          <a class="rbook" href="{{ site.bookingUrl }}">{{ T.ui.checkDates }}</a></div>
      </div>
    </article>
  {%- endfor %}
  </div>
  <p class="narrow" style="margin:3rem auto 0;text-align:center;color:var(--sage)">{{ home.roomsNote }}</p>
  <p class="narrow" style="margin:1rem auto 0;text-align:center">{{ T.ui.groupLine }} <a href="{{ langPrefix }}/whole-house/">{{ T.ui.groupLink }}</a>, {{ T.ui.groupAfter }}</p>
</div></section>

<section id="house" class="quiet"><div class="wrap">
  <div class="cols">
    <div>
      <div class="rule"></div>
      <h2>{{ home.houseTitle }}</h2>
      {{ home.houseText | md | safe }}
      <p><a href="{{ langPrefix }}/house/">{{ T.ui.seeHouse }}</a></p>
    </div>
    <div>
      <ul class="list">
      {%- for a in home.amenities %}
        <li>{{ a.label }} <span>{{ a.value }}</span></li>
      {%- endfor %}
      </ul>
    </div>
  </div>
</div></section>

<section id="reviews"><div class="wrap">
  <div class="narrow"><div class="rule"></div>
    <h2>{{ T.reviews.title }}</h2>
    <p>{{ T.reviews.intro }}</p>
  </div>
  <div class="reviews" style="margin-top:2.5rem">
  {%- for r in T.reviews.items %}
    <blockquote class="review">
      <p>&ldquo;{{ r.text }}&rdquo;</p>
      <footer>{{ r.name }}, {{ r.from }} <span>{{ r.date }}</span></footer>
    </blockquote>
  {%- endfor %}
  </div>
</div></section>

<section id="island" class="quiet"><div class="wrap">
  <div class="island">
    <figure class="shot wide"><img src="{{ home.islandImage or '/uploads/portree-harbour.webp' }}" alt="{{ home.islandAlt }}" sizes="(min-width: 900px) 45vw, 100vw" loading="lazy"></figure>
    <div>
      <div class="rule"></div>
      <h2>{{ home.islandTitle }}</h2>
      <p>{{ home.islandText }}</p>
      <ul class="list" style="margin:1.5rem 0 0">
      {%- for d in home.distances %}
        <li>{{ d.place }} <span>{{ d.time }}</span></li>
      {%- endfor %}
      </ul>
      <p style="margin-top:1.5rem"><a href="{{ langPrefix }}/skye/">{{ T.ui.moreSkye }}</a> &nbsp;·&nbsp; <a href="{{ langPrefix }}/getting-here/">{{ T.ui.nav.getting }}</a></p>
    </div>
  </div>
</div></section>

<section id="book" class="book"><div class="wrap">
  <h2>{{ home.bookTitle }}</h2>
  <p>{{ home.bookText }}</p>
  <a class="btn" href="{{ site.bookingUrl }}">{{ T.ui.seeDates }}</a>
  <p style="margin-top:1.5rem;font-size:.95rem"><a href="tel:{{ site.phoneLink }}" style="color:#fff">{{ site.phone }}</a></p>
</div></section>
