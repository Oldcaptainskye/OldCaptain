---
layout: base.njk
---
<section><div class="wrap">
  <p class="caption" style="padding:0;margin:0 0 1.5rem"><a href="{{ langPrefix }}/#rooms">{{ T.ui.roomsCrumb }}</a> / {{ title }}</p>
  <div class="cols">
    <div class="shot"><img src="{{ image }}" alt="{{ imageAlt }}" sizes="(min-width: 780px) 50vw, 100vw" loading="eager" fetchpriority="high"></div>
    <div>
      <div class="rule"></div>
      <h1 style="font-size:clamp(1.8rem,3.4vw,2.3rem)">{{ title }}</h1>
      <p class="caption" style="padding:0;margin:.5rem 0 1.25rem">{{ type | upper }} &middot; {{ T.ui.sleeps | upper }} {{ sleeps }}{% if bathroom %} &middot; {{ bathroom | upper }}{% endif %}</p>
      <div class="prose">{{ content | safe }}</div>
      <div class="rate">{% if rate %}{{ T.ui.fromNight | replace("{rate}", rate) }}{% endif %}
        <a class="rbook" href="{{ site.bookingUrl }}">{{ T.ui.checkDates }}</a></div>
    </div>
  </div>
  {%- if gallery and gallery.length %}
  <div class="gallery" style="margin-top:3rem">
  {%- for g in gallery %}
    <figure><img src="{{ g.image }}" alt="{{ g.alt }}" sizes="(min-width: 780px) 33vw, 50vw"></figure>
  {%- endfor %}
  </div>
  {%- endif %}
</div></section>

<section class="quiet"><div class="wrap">
  <div class="narrow"><div class="rule"></div><h2>{{ T.ui.inEveryRoom }}</h2></div>
  <div class="cols" style="margin-top:1.5rem">
    <ul class="list" style="margin:0">
      <li>{{ T.ui.bathroom }} <span>{% if bathroom %}{% if lang == "de" %}{{ bathroom[0] | lower }}{{ bathroom.slice(1) }}{% else %}{{ bathroom | lower }}{% endif %}{% else %}{{ T.ui.privateEnsuite }}{% endif %}</span></li>
      <li>{{ T.ui.hairdryer }} <span>{{ T.ui.provided }}</span></li>
      <li>{{ T.ui.tv }} <span>{{ T.ui.yes }}</span></li>
    </ul>
    <ul class="list" style="margin:0">
      <li>{{ T.ui.wifi }} <span>{{ T.ui.free }}</span></li>
      <li>{{ T.ui.breakfast }} <span>{{ T.ui.breakfastValue }}</span></li>
      <li>{{ T.ui.parking }} <span>{{ T.ui.onRequest }}</span></li>
    </ul>
  </div>
</div></section>

<section class="book"><div class="wrap">
  <h2>{{ T.ui.bookRoom | replace("{title}", title) }}</h2>
  <p>{{ T.ui.directLine }}</p>
  <a class="btn" href="{{ site.bookingUrl }}">{{ T.ui.seeDates }}</a>
  <p style="margin-top:1.5rem;font-size:.95rem"><a href="tel:{{ site.phoneLink }}" style="color:#fff">{{ site.phone }}</a></p>
</div></section>
