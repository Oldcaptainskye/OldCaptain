<!DOCTYPE html>
<html lang="{{ lang }}{% if lang == 'en' %}-GB{% endif %}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ seoTitle or title }}</title>
<meta name="description" content="{{ description }}">
<link rel="canonical" href="{{ site.url }}{{ page.url }}">
{%- set basePath = page.url | stripLang %}
{%- for l in site.languages %}
<link rel="alternate" hreflang="{{ l[0] }}" href="{{ site.url }}{{ basePath | localeUrl(l[0]) }}">
{%- endfor %}
<link rel="alternate" hreflang="x-default" href="{{ site.url }}{{ basePath }}">
<meta property="og:title" content="{{ seoTitle or title }}">
<meta property="og:description" content="{{ description }}">
<meta property="og:image" content="{{ site.url }}{{ ogImage or site.heroImage }}">
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
<meta property="og:type" content="website">
<meta property="og:locale" content="{{ T.ui.ogLocale or 'en_GB' }}">
<link rel="icon" href="/assets/icon-32.png" sizes="32x32">
<link rel="icon" href="/assets/icon-512.png" sizes="512x512">
<link rel="apple-touch-icon" href="/assets/icon-180.png">
<link rel="stylesheet" href="/assets/site.css?v=20261022">
<script type="application/ld+json">
{
  "@context":"https://schema.org","@type":"BedAndBreakfast",
  "name":"{{ site.name }}","url":"{{ site.url }}/",
  "telephone":"{{ site.phoneLink }}","email":"{{ site.email }}",
  "image":"{{ site.url }}{{ site.heroImage }}",
  "address":{"@type":"PostalAddress","streetAddress":"{{ site.street }}","addressLocality":"{{ site.town }}","addressRegion":"{{ site.region }}","postalCode":"{{ site.postcode }}","addressCountry":"GB"},
  "geo":{"@type":"GeoCoordinates","latitude":{{ site.lat }},"longitude":{{ site.lng }}},
  "checkinTime":"{{ site.checkin }}","checkoutTime":"{{ site.checkout }}",
  "numberOfRooms":{{ site.rooms }},"petsAllowed":false,"smokingAllowed":false,
  "amenityFeature":[
    {"@type":"LocationFeatureSpecification","name":"Complimentary breakfast, self-service","value":true},
    {"@type":"LocationFeatureSpecification","name":"Parking on request","value":true},
    {"@type":"LocationFeatureSpecification","name":"Free Wi-Fi","value":true},
    {"@type":"LocationFeatureSpecification","name":"Guest kitchen","value":true}
  ]
}
</script>
<!-- Netlify Identity: needed so the owners' invitation and password-reset links work -->
<script defer src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
</head>
<body>
<a class="skip" href="#main">{{ T.ui.skip }}</a>

<header>
  <a class="mark" href="{{ langPrefix }}/">{% if site.logo %}<img src="{{ site.logo }}" alt="{{ site.logoAlt or site.name }}" sizes="160px" loading="eager" fetchpriority="high">{% else %}{{ site.shortName }}{% endif %}<em>{{ site.tagline | upper }}</em></a>
  <nav aria-label="Main">
    <a href="{{ langPrefix }}/#rooms">{{ T.ui.nav.rooms }}</a>
    <a href="{{ langPrefix }}/house/">{{ T.ui.nav.house }}</a>
    <a href="{{ langPrefix }}/skye/">{{ T.ui.nav.island }}</a>
    <a href="{{ langPrefix }}/getting-here/">{{ T.ui.nav.getting }}</a>
    <a href="{{ langPrefix }}/contact/">{{ T.ui.nav.contact }}</a>
    <a class="book-link" href="{{ langPrefix }}/check-dates/">{{ T.ui.nav.check }}</a>
  </nav>
  <div class="langs" aria-label="Language">
    {%- for l in site.languages %}
    {%- if l[0] == lang %}<span aria-current="true">{{ l[1] }}</span>{% else %}<a href="{{ basePath | localeUrl(l[0]) }}" hreflang="{{ l[0] }}" lang="{{ l[0] }}">{{ l[1] }}</a>{% endif %}
    {%- endfor %}
  </div>
</header>

<main id="main">
{{ content | safe }}
</main>

<footer><div class="wrap">
  <div>{{ site.name }}, {{ site.street }}, {{ site.town }}, {{ site.region }} {{ site.postcode }}</div>
  <div>
    <a href="tel:{{ site.phoneLink }}">{{ site.phone }}</a> &nbsp;
    <a href="mailto:{{ site.email }}">{{ site.email }}</a> &nbsp;
    <a href="{{ langPrefix }}/terms/">{{ T.ui.footer.terms }}</a> &nbsp;
    <a href="{{ langPrefix }}/privacy/">{{ T.ui.footer.privacy }}</a> &nbsp;
    <a href="#" id="cc-open" hidden></a>
  </div>
</div></footer>
<script>
  // After accepting an invitation on the site root, send the owner on to the editor.
  window.addEventListener("DOMContentLoaded", function () {
    if (window.netlifyIdentity) {
      window.netlifyIdentity.on("init", function (user) {
        if (!user) window.netlifyIdentity.on("login", function () { document.location.href = "/admin/"; });
      });
    }
  });
</script>
<div id="oc-consent" role="dialog" aria-label="Cookies" hidden>
  <p id="cc-text"></p>
  <div class="cc-actions"><button type="button" id="cc-decline"></button><button type="button" id="cc-accept"></button></div>
</div>
<script>
  // Analytics (Google Analytics 4) loads only after the visitor accepts. Choice is kept in this browser.
  (function () {
    var ID = "G-R35J9HKNF7", KEY = "oc-consent";
    var L = {
      en: {t: "We would like to use analytics cookies to see how visitors find this site. Nothing is set unless you accept.", a: "Accept", d: "Decline", c: "Cookies", p: "/privacy/"},
      de: {t: "Wir möchten Analyse-Cookies verwenden, um zu sehen, wie Besucher diese Website finden. Ohne Ihre Zustimmung wird nichts gesetzt.", a: "Akzeptieren", d: "Ablehnen", c: "Cookies", p: "/de/privacy/"},
      es: {t: "Nos gustaría usar cookies de análisis para ver cómo nos encuentran los visitantes. Sin su aceptación no se instala nada.", a: "Aceptar", d: "Rechazar", c: "Cookies", p: "/es/privacy/"},
      fr: {t: "Nous aimerions utiliser des cookies d'analyse pour voir comment les visiteurs trouvent ce site. Rien n'est déposé sans votre accord.", a: "Accepter", d: "Refuser", c: "Cookies", p: "/fr/privacy/"},
      it: {t: "Vorremmo usare cookie di analisi per capire come i visitatori trovano il sito. Senza il vostro consenso non viene impostato nulla.", a: "Accetta", d: "Rifiuta", c: "Cookie", p: "/it/privacy/"}
    };
    var lang = (document.documentElement.lang || "en").slice(0, 2); if (!L[lang]) lang = "en";
    var T = L[lang];
    function get() { try { return localStorage.getItem(KEY); } catch (e) { return null; } }
    function set(v) { try { localStorage.setItem(KEY, v); } catch (e) {} }
    function load() {
      if (window.__ocGa) return; window.__ocGa = true;
      var s = document.createElement("script"); s.async = true; s.src = "https://www.googletagmanager.com/gtag/js?id=" + ID; document.head.appendChild(s);
      window.dataLayer = window.dataLayer || []; window.gtag = function () { dataLayer.push(arguments); };
      gtag("js", new Date()); gtag("config", ID, {allow_google_signals: false, allow_ad_personalization_signals: false});
    }
    function off() {
      window["ga-disable-" + ID] = true;
      document.cookie.split(";").forEach(function (c) {
        var n = c.split("=")[0].trim();
        if (n === "_ga" || n.indexOf("_ga_") === 0) {
          document.cookie = n + "=;expires=Thu, 01 Jan 1970 00:00:00 GMT;path=/";
          document.cookie = n + "=;expires=Thu, 01 Jan 1970 00:00:00 GMT;path=/;domain=" + location.hostname;
          document.cookie = n + "=;expires=Thu, 01 Jan 1970 00:00:00 GMT;path=/;domain=." + location.hostname.replace(/^www\./, "");
        }
      });
    }
    document.addEventListener("DOMContentLoaded", function () {
      var box = document.getElementById("oc-consent"), open = document.getElementById("cc-open");
      document.getElementById("cc-text").innerHTML = T.t + ' <a href="' + T.p + '">' + (lang === "en" ? "Privacy and cookies" : T.c) + "</a>";
      document.getElementById("cc-accept").textContent = T.a; document.getElementById("cc-decline").textContent = T.d;
      open.textContent = T.c; open.hidden = false;
      var v = get();
      if (v === "yes") load(); else if (v === "no") off(); else box.hidden = false;
      document.getElementById("cc-accept").addEventListener("click", function () { set("yes"); box.hidden = true; load(); });
      document.getElementById("cc-decline").addEventListener("click", function () { set("no"); box.hidden = true; off(); });
      open.addEventListener("click", function (e) { e.preventDefault(); box.hidden = false; });
    });
  })();
</script>
</body>
</html>
