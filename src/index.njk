---
layout: base.njk
title: "B&B in Portree, Isle of Skye | Old Captain Guest House"
description: "A quiet five-room guest house in Portree, Isle of Skye, five minutes' walk from the town centre and bus station. Complimentary breakfast, parking on request. Book direct."
---
<div class="statement"><div class="wrap">
  <h1>{{ home.headline }}</h1>
  <p>{{ home.intro }}</p>
  <p class="top-book"><a href="{{ site.bookingUrl }}">See dates and rates</a>
    <span>or call <a href="tel:{{ site.phoneLink }}">{{ site.phone }}</a></span></p>
</div></div>

<figure class="plate">
  <img src="{{ site.heroImage }}" alt="{{ site.heroAlt }}" sizes="100vw" loading="eager" fetchpriority="high">
  <figcaption class="caption">{{ home.heroCaption }}</figcaption>
</figure>

<section id="rooms"><div class="wrap wrap-rooms">
  <div class="narrow"><div class="rule"></div>
    <h2>Rooms</h2>
    <p>{{ home.roomsIntro }}</p>
  </div>

  <div style="margin-top:4rem">
  {%- for room in collections.rooms %}
    <article class="room">
      <div class="shot">
        <a href="{{ room.url }}"><img src="{{ room.data.image }}" alt="{{ room.data.imageAlt }}" sizes="(min-width: 860px) 40vw, 100vw"></a>
      </div>
      <div class="text">
        <div class="rlabel">
          <h3><a href="{{ room.url }}">{{ room.data.title }}</a></h3>
          <span class="n">{{ room.data.type | upper }} &middot; SLEEPS {{ room.data.sleeps }}</span>
        </div>
        <p>{{ room.data.summary }}</p>
        <div class="rate">{% if room.data.rate %}From <b>{{ room.data.rate }}</b> a night{% endif %}
          <a class="rbook" href="{{ site.bookingUrl }}">Check dates</a></div>
      </div>
    </article>
  {%- endfor %}
  </div>
  <p class="narrow" style="margin:3rem auto 0;text-align:center;color:var(--sage)">{{ home.roomsNote }}</p>
  <p class="narrow" style="margin:1rem auto 0;text-align:center">Travelling as a group? <a href="/whole-house/">Book the whole house</a>, sleeps ten.</p>
</div></section>

<section id="house" class="quiet"><div class="wrap">
  <div class="cols">
    <div>
      <div class="rule"></div>
      <h2>{{ home.houseTitle }}</h2>
      {{ home.houseText | md | safe }}
      <p><a href="/house/">See the house</a></p>
    </div>
    <div>
      <ul class="list">
      {%- for a in home.amenities %}
        <li>{{ a.label }} <span>{{ a.value }}</span></li>
      {%- endfor %}
      </ul>
    </div>
  </div>
</div></section>

<section id="reviews"><div class="wrap">
  <div class="narrow"><div class="rule"></div>
    <h2>{{ reviews.title }}</h2>
    <p>{{ reviews.intro }}</p>
  </div>
  <div class="reviews" style="margin-top:2.5rem">
  {%- for r in reviews.items %}
    <blockquote class="review">
      <p>&ldquo;{{ r.text }}&rdquo;</p>
      <footer>{{ r.name }}, {{ r.from }} <span>{{ r.date }}</span></footer>
    </blockquote>
  {%- endfor %}
  </div>
</div></section>

<section id="island" class="quiet"><div class="wrap">
  <div class="narrow"><div class="rule"></div>
    <h2>{{ home.islandTitle }}</h2>
    <p>{{ home.islandText }}</p>
  </div>
  {%- set half = (home.distances.length / 2) | round(0, "ceil") %}
  <div class="cols" style="margin-top:2.5rem">
    <ul class="list" style="margin:0">
    {%- for d in home.distances %}{% if loop.index0 < half %}
      <li>{{ d.place }} <span>{{ d.time }}</span></li>
    {%- endif %}{% endfor %}
    </ul>
    <ul class="list" style="margin:0">
    {%- for d in home.distances %}{% if loop.index0 >= half %}
      <li>{{ d.place }} <span>{{ d.time }}</span></li>
    {%- endif %}{% endfor %}
    </ul>
  </div>
  <p style="margin-top:2rem"><a href="/skye/">More on what to do from Portree</a> &nbsp;·&nbsp; <a href="/getting-here/">Getting here</a></p>
</div></section>

<section id="book" class="book"><div class="wrap">
  <h2>{{ home.bookTitle }}</h2>
  <p>{{ home.bookText }}</p>
  <a class="btn" href="{{ site.bookingUrl }}">See dates and rates</a>
  <p style="margin-top:1.5rem;font-size:.95rem"><a href="tel:{{ site.phoneLink }}" style="color:#fff">{{ site.phone }}</a></p>
</div></section>
