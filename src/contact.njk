---
layout: base.njk
title: "Contact and directions | Old Captain Guest House, Portree"
description: "How to find Old Captain Guest House at 1 Blaven Road, Portree, Isle of Skye. Telephone, email and directions."
permalink: "/contact/"
ogImage: "/uploads/portree-harbour.webp"
---
<section><div class="wrap">
  <div class="narrow"><div class="rule"></div>
    <h1 style="font-size:clamp(1.8rem,3.4vw,2.3rem)">{{ contact.title }}</h1>
  </div>
  <div class="cols" style="margin-top:2rem">
    <div>
      <ul class="list" style="margin:0">
        <li>Address <span>{{ site.street }}</span></li>
        <li>&nbsp; <span>{{ site.town }}, {{ site.region }}</span></li>
        <li>&nbsp; <span>{{ site.postcode }}</span></li>
        <li>Telephone <span><a href="tel:{{ site.phoneLink }}">{{ site.phone }}</a></span></li>
        <li>Email <span><a href="mailto:{{ site.email }}">{{ site.email }}</a></span></li>
      </ul>
      <p style="margin-top:1.75rem">
        <a class="rbook" href="https://www.google.com/maps/search/?api=1&amp;query={{ site.name | urlencode }}+{{ site.town }}" target="_blank" rel="noopener">Open in Google Maps</a>
      </p>
    </div>
    <div>
      <p style="margin-top:0">{{ contact.directions }}</p>
      <p>Check in is between {{ site.checkin }} and {{ site.checkinUntil }}, and check out by {{ site.checkout }}. {{ contact.arrival }}</p>
    </div>
  </div>
  <div class="narrow" style="margin-top:3.5rem"><div class="rule"></div>
    <h2>Send us a message</h2>
  </div>
  <div style="margin-top:1.5rem;max-width:40rem">
<form class="enquiry" name="contact" method="POST" action="/thanks/" data-netlify="true" netlify-honeypot="website">
  <input type="hidden" name="form-name" value="contact">
  <p class="hp"><label>Leave this empty <input name="website"></label></p>
  <div class="cols">
    <label>Your name <input name="name" required autocomplete="name"></label>
    <label>Email <input name="email" type="email" required autocomplete="email"></label>
  </div>
  <div class="cols">
    <label>Telephone <input name="phone" type="tel" autocomplete="tel"></label>
    <label>Dates, if you have them <input name="dates" placeholder="e.g. 3–5 June"></label>
  </div>
  <label>Message <textarea name="message" rows="5" required placeholder="How can we help?"></textarea></label>
  <button type="submit" class="btn btn-dark">Send</button>
  <p class="small">We reply by email, usually the same day.</p>
</form>
  </div>
</div></section>
